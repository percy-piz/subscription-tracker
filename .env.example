# Copy to .env (git-ignored) and fill in. Read by infra/bin/app.ts at synth/deploy time.
AWS_PROFILE=subtrack-dev
AWS_REGION=us-east-1
# Where budget + alert emails go
ALERT_EMAIL=you@example.com
# Domain you control for SES inbound (Week 1). Leave blank until SES is set up.
INBOUND_DOMAIN=
# Monthly AWS budget alarm in USD
BUDGET_USD=5
